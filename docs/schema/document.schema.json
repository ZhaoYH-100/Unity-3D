{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "项目资料元数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "type",
    "domain",
    "status",
    "version",
    "revision",
    "owner",
    "createdAt",
    "updatedAt",
    "summary",
    "tags",
    "primaryFile",
    "file",
    "provenance",
    "related",
    "supersedes",
    "supersededBy",
    "versions",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{8}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "requirements",
        "plan",
        "design",
        "specification",
        "report",
        "test-plan",
        "decision",
        "runbook",
        "meeting",
        "delivery",
        "research",
        "other"
      ]
    },
    "domain": {
      "enum": [
        "general",
        "project",
        "requirements",
        "unity",
        "backend",
        "web",
        "qa",
        "delivery",
        "research"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "active",
        "superseded",
        "archived"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "primaryFile": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "generator",
        "modelVersion",
        "promptRef",
        "sourceRefs",
        "humanReview",
        "reviewNotes"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai",
            "mixed",
            "imported"
          ]
        },
        "generator": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "promptRef": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "humanReview": {
          "enum": [
            "pending",
            "reviewed",
            "not-required"
          ]
        },
        "reviewNotes": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DOC-[0-9]{8}-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "action",
          "actor",
          "fromStatus",
          "toStatus",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "fromStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "toStatus": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
